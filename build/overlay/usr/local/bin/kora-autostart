#!/bin/sh
# defaults come from /etc/skel; generate only on first run, never overwrite user settings
[ -e ~/.config/kora/theme ] && [ -e ~/.config/waybar/style.css ] || kora-theme night --noapply
swaybg -i ~/.config/kora/wallpaper -m fill &
mako &
kora-panel top & kora-panel dock &
[ -e ~/.config/kora/night ] && wlsunset -t 4000 -T 6500 -S 07:00 -s 20:00 &
if ! grep -qw boot=casper /proc/cmdline; then
  if [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then hypridle & else swayidle -w timeout 300 kora-lock before-sleep kora-lock & fi
fi
