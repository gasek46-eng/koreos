#!/usr/bin/env python3
"""Kora Settings — Wi-Fi, sound, display, appearance, power, apps, diagnostics (Kora Doctor), about.
Usage: kora-settings [wifi|sound|display|look|power|apps|doctor|about]   |   kora-settings --report"""
import os, re, sys, glob, shutil, subprocess, threading
H = os.path.expanduser('~'); K = f'{H}/.config/kora'
LIVE = 'boot=casper' in open('/proc/cmdline').read()

def sh(cmd, t=8):
    try: return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=t).stdout.strip()
    except Exception: return ''

def root(cmd):
    """Run a command as root: silently if sudo allows it, otherwise in a terminal that asks for the password."""
    if subprocess.run('sudo -n true', shell=True, capture_output=True).returncode == 0:
        return subprocess.Popen(['sudo', 'sh', '-c', cmd])
    return subprocess.Popen(['foot', '-T', 'Kora', 'sh', '-c', f'echo "Kora: нужен пароль администратора"; sudo sh -c \'{cmd}\'; echo; read -p "Готово. Enter — закрыть" x'])

def term(cmd):
    return subprocess.Popen(['foot', '-T', 'Kora', 'sh', '-c', f'{cmd}; echo; read -p "Готово. Enter — закрыть" x'])

# ---------- Kora Doctor: checks return (status, title, detail, fix_label, fix_cmd) ; status: ok|warn|bad
def checks():
    r = []
    rf = sh('rfkill list wifi')
    pci = sh('lspci -nnk')
    net = [b for b in pci.split('\n\n') if re.search(r'Network controller|Wireless', b)]
    if not net and 'Network controller' not in pci:
        blocks = re.split(r'\n(?=\S)', pci); net = [b for b in blocks if 'Network controller' in b]
    wifi_dev = sh("nmcli -t -f DEVICE,TYPE dev | grep ':wifi$' | cut -d: -f1")
    if 'Hard blocked: yes' in rf:
        r.append(('bad', 'Wi-Fi выключен кнопкой', 'Нажмите кнопку или клавишу Wi-Fi на корпусе (значок антенны или самолёта).', None, None))
    elif 'Soft blocked: yes' in rf:
        r.append(('bad', 'Wi-Fi выключен программно', 'Адаптер заблокирован (rfkill).', 'Включить', 'rfkill unblock all'))
    elif wifi_dev:
        r.append(('ok', 'Wi-Fi адаптер работает', f'Устройство {wifi_dev}', None, None))
    else:
        info = ''
        for b in net:
            ids = re.findall(r'\[([0-9a-f]{4}:[0-9a-f]{4})\]', b); drv = re.search(r'Kernel driver in use: (\S+)', b)
            name = b.split(': ', 1)[-1].split('\n')[0][:70]
            info += f"{name} ({ids[-1] if ids else '?'}) — " + (f"драйвер {drv.group(1)}" if drv else 'драйвер не загружен') + '\n'
        fw = sh("journalctl -k -b --no-pager 2>/dev/null | grep -iE 'firmware.*(fail|error)|Direct firmware load' | tail -3")
        r.append(('bad', 'Wi-Fi адаптер не найден', (info or 'Беспроводной адаптер не обнаружен.') + (('\nОшибки микропрограммы:\n' + fw) if fw else ''),
                  'Перезапустить сеть', 'modprobe -r iwlmvm iwlwifi 2>/dev/null; modprobe iwlwifi 2>/dev/null; systemctl restart NetworkManager'))
    con = sh('nmcli networking connectivity')
    r.append(('ok' if con == 'full' else 'warn', 'Интернет', 'Подключено' if con == 'full' else 'Нет подключения к интернету', None, None))
    drv = [os.path.basename(os.path.realpath(f'{c}/device/driver')) for c in glob.glob('/sys/class/drm/card[0-9]') if os.path.exists(f'{c}/device/driver')]
    hypr = bool(os.environ.get('HYPRLAND_INSTANCE_SIGNATURE'))
    accel = any(d in ('i915', 'xe', 'amdgpu', 'radeon', 'nouveau') for d in drv)
    r.append(('ok' if accel else 'warn', 'Графика', f"Драйвер: {', '.join(drv) or 'нет'} · оболочка: {'Hyprland (с ускорением)' if hypr else 'labwc (лёгкий режим)'}", None, None))
    snd = sh('wpctl status 2>/dev/null')
    sinks = re.search(r'Sinks:\n(.*?)\n\s*│?\s*\n', snd, re.S)
    has = sinks and re.search(r'\d+\.', sinks.group(1)) and 'Dummy' not in sinks.group(1)
    r.append(('ok' if has else 'warn', 'Звук', 'Устройство вывода найдено' if has else 'Устройство вывода звука не найдено', 'Перезапустить звук' if not has else None,
              None if has else 'USERCMD:systemctl --user restart pipewire wireplumber'))
    bl = glob.glob('/sys/class/backlight/*')
    if bl:
        w = all(os.access(f'{b}/brightness', os.W_OK) for b in bl)
        r.append(('ok' if w else 'warn', 'Яркость экрана', ', '.join(os.path.basename(b) for b in bl) + ('' if w else ' — нет прав'), None if w else 'Исправить',
                  None if w else 'chmod 666 /sys/class/backlight/*/brightness'))
    bat = sh("upower -i $(upower -e | grep -m1 BAT) 2>/dev/null")
    if bat:
        cap = re.search(r'capacity:\s+([\d.]+)', bat); pct = re.search(r'percentage:\s+(\d+)', bat)
        c = float(cap.group(1)) if cap else 100
        r.append(('ok' if c >= 60 else 'warn', 'Аккумулятор', f"Заряд {pct.group(1) if pct else '?'}% · износ: осталось {c:.0f}% ёмкости", None, None))
    du = shutil.disk_usage(H); free = du.free / du.total * 100
    r.append(('ok' if free > 10 else 'warn', 'Свободное место', f"{du.free/1e9:.1f} ГБ свободно ({free:.0f}%)", None, None))
    mem = sh("free -m | awk '/Mem/{print $2}'"); z = 'zram включён' if sh('swapon --show | grep zram') else 'zram выключен'
    r.append(('ok', 'Память', f"{mem} МБ · {z}", None, None))
    err = sh("journalctl -p 3 -b --no-pager -q 2>/dev/null | wc -l")
    r.append(('ok' if (err or '0') == '0' else 'warn', 'Системные ошибки', f"{err or 0} ошибок за эту загрузку", None, None))
    bt = sh('systemd-analyze 2>/dev/null | head -1')
    r.append(('ok', 'Время загрузки', bt.replace('Startup finished in ', '') or 'нет данных', None, None))
    return r

def report():
    out = ['Kora OS — отчёт о системе', sh('cat /etc/kora-release'), sh('uname -a'), '']
    for s, t, d, *_ in checks(): out.append(f"[{s.upper()}] {t}: {d}")
    for c in ['lspci -nnk', 'rfkill list', 'nmcli dev', 'journalctl -k -b --no-pager | grep -iE "firmware|iwl|wlan|rtw|ath" | tail -40', 'journalctl -p 3 -b --no-pager -q | tail -40']:
        out += ['', '$ ' + c, sh(c, 20)]
    p = f'{H}/kora-report.txt'; open(p, 'w').write('\n'.join(out)); return p

if '--report' in sys.argv:
    print(report()); sys.exit()

import gi
gi.require_version('Gtk', '4.0'); gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, GLib, Gio, GdkPixbuf

THEMES = [('night', 'Ночь'), ('ocean', 'Океан'), ('forest', 'Лес'), ('sunset', 'Закат'), ('graphite', 'Графит'), ('day', 'День'), ('dawn', 'Рассвет'), ('mist', 'Туман')]

def row(title, sub=None, widget=None):
    r = Adw.ActionRow(title=title); r.set_subtitle(sub or '')
    if widget: r.add_suffix(widget); widget.set_valign(Gtk.Align.CENTER)
    return r

def group(title=None, desc=None):
    g = Adw.PreferencesGroup(); g.set_title(title or ''); g.set_description(desc or ''); return g

class Settings(Adw.Application):
    def __init__(self):
        super().__init__(application_id='os.kora.Settings', flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
    def do_command_line(self, cl):
        self.activate(); a = cl.get_arguments()[1:]
        if a and a[0] in self.pages: self.stack.set_visible_child_name(a[0])
        return 0
    def do_activate(self):
        if getattr(self, 'win', None): self.win.present(); return
        self.win = w = Adw.ApplicationWindow(application=self, title='Настройки Kora', default_width=920, default_height=640)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.pages = {}
        for name, title, icon, fn in [('wifi', 'Wi-Fi', 'network-wireless-symbolic', self.p_wifi), ('sound', 'Звук', 'audio-volume-high-symbolic', self.p_sound),
                                      ('display', 'Экран', 'video-display-symbolic', self.p_display), ('look', 'Оформление', 'preferences-desktop-appearance-symbolic', self.p_look),
                                      ('power', 'Питание', 'battery-good-symbolic', self.p_power), ('apps', 'Приложения', 'system-software-install-symbolic', self.p_apps),
                                      ('doctor', 'Kora Доктор', 'emblem-ok-symbolic', self.p_doctor), ('about', 'О системе', 'help-about-symbolic', self.p_about)]:
            page = Adw.PreferencesPage(); fn(page); self.stack.add_titled(page, name, title); self.pages[name] = icon
        side = Gtk.StackSidebar(stack=self.stack); side.set_size_request(210, -1)
        split = Gtk.Paned(start_child=side, end_child=self.stack, shrink_start_child=False, resize_start_child=False)
        tv = Adw.ToolbarView(); tv.add_top_bar(Adw.HeaderBar()); tv.set_content(split); w.set_content(tv); w.present()

    # ---- Wi-Fi
    def p_wifi(self, p):
        g = group('Wi-Fi', 'Нажмите на сеть, чтобы подключиться'); self.wg = g; p.add(g)
        sw = Gtk.Switch(active=sh('nmcli radio wifi') == 'enabled'); sw.connect('state-set', lambda s, v: (sh(f"nmcli radio wifi {'on' if v else 'off'}"), GLib.timeout_add(1500, self.wifi_fill)) and False)
        top = group(); top.add(row('Беспроводная сеть', 'Включить или выключить Wi-Fi', sw))
        b = Gtk.Button(label='Обновить список'); b.connect('clicked', lambda *_: self.wifi_fill()); top.add(row('Поиск сетей', None, b)); p.add(top)
        p.remove(g); p.add(g); self.wrows = []; GLib.idle_add(self.wifi_fill)
    def wifi_fill(self):
        for r in self.wrows: self.wg.remove(r)
        self.wrows = []
        out = sh('nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY dev wifi list --rescan yes', 20)
        seen = set()
        for l in out.splitlines():
            f = re.split(r'(?<!\\):', l)
            if len(f) < 4 or not f[1] or f[1] in seen: continue
            seen.add(f[1]); ssid = f[1].replace('\\:', ':')
            r = Adw.ActionRow(title=ssid, subtitle=f"{f[2]}%{' · защищена' if f[3] else ''}{' · подключено' if f[0] == '*' else ''}", activatable=True)
            r.add_prefix(Gtk.Image(icon_name='network-wireless-signal-' + ('excellent' if int(f[2] or 0) > 70 else 'good' if int(f[2] or 0) > 40 else 'weak') + '-symbolic'))
            r.connect('activated', lambda _r, s=ssid, sec=bool(f[3]): self.wifi_connect(s, sec))
            self.wg.add(r); self.wrows.append(r)
        if not self.wrows:
            r = Adw.ActionRow(title='Сети не найдены', subtitle='Проверьте раздел «Kora Доктор»'); self.wg.add(r); self.wrows.append(r)
        return False
    def wifi_connect(self, ssid, secure):
        known = ssid in sh('nmcli -t -f NAME con show').splitlines()
        if known or not secure:
            ok = subprocess.run(['nmcli', 'dev', 'wifi', 'connect', ssid] if not known else ['nmcli', 'con', 'up', 'id', ssid], capture_output=True).returncode == 0
            self.toast(f"{'Подключено' if ok else 'Не удалось подключиться'}: {ssid}"); self.wifi_fill(); return
        d = Adw.MessageDialog(transient_for=self.win, heading=f'Пароль для «{ssid}»'); e = Gtk.PasswordEntry(show_peek_icon=True); d.set_extra_child(e)
        d.add_response('cancel', 'Отмена'); d.add_response('ok', 'Подключить'); d.set_response_appearance('ok', Adw.ResponseAppearance.SUGGESTED)
        def resp(dd, rid):
            if rid == 'ok':
                ok = subprocess.run(['nmcli', 'dev', 'wifi', 'connect', ssid, 'password', e.get_text()], capture_output=True).returncode == 0
                self.toast(f"{'Подключено' if ok else 'Неверный пароль или ошибка'}: {ssid}"); self.wifi_fill()
        d.connect('response', resp); d.present()
    def toast(self, msg): subprocess.Popen(['notify-send', 'Kora', msg])

    # ---- Sound
    def p_sound(self, p):
        g = group('Звук'); p.add(g)
        v = sh('wpctl get-volume @DEFAULT_AUDIO_SINK@'); vol = float((re.findall(r'[\d.]+', v) or ['0.5'])[0]) * 100
        s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1); s.set_value(vol); s.set_size_request(320, -1)
        s.connect('value-changed', lambda x: sh(f'wpctl set-volume @DEFAULT_AUDIO_SINK@ {x.get_value()/100:.2f}'))
        g.add(row('Громкость', None, s))
        m = Gtk.Switch(active='MUTED' in v); m.connect('state-set', lambda *_: sh('wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle') and False); g.add(row('Без звука', None, m))
        b = Gtk.Button(label='Bluetooth-устройства'); b.connect('clicked', lambda *_: subprocess.Popen(['blueman-manager'])); g.add(row('Наушники и колонки Bluetooth', None, b))

    # ---- Display
    def p_display(self, p):
        g = group('Экран'); p.add(g)
        if glob.glob('/sys/class/backlight/*'):
            cur = sh('brightnessctl -m') .split(','); pct = float(cur[3].rstrip('%')) if len(cur) > 3 else 80
            s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 5, 100, 1); s.set_value(pct); s.set_size_request(320, -1)
            s.connect('value-changed', lambda x: sh(f'brightnessctl -q s {int(x.get_value())}%')); g.add(row('Яркость', None, s))
        n = Gtk.Switch(active=os.path.exists(f'{K}/night')); n.connect('state-set', self.night); g.add(row('Ночной режим', 'Тёплый экран с 20:00 до 7:00', n))
        b = Gtk.Button(label='Мониторы…'); b.connect('clicked', lambda *_: subprocess.Popen(['wdisplays'])); g.add(row('Разрешение и мониторы', None, b))
    def night(self, s, v):
        if v: open(f'{K}/night', 'w').close(); subprocess.Popen(['setsid', 'wlsunset', '-t', '4000', '-T', '6500', '-S', '07:00', '-s', '20:00'])
        else:
            try: os.remove(f'{K}/night')
            except OSError: pass
            sh('pkill -x wlsunset')
        return False

    # ---- Appearance
    def p_look(self, p):
        g = group('Тема оформления', 'Цвета панелей, окон, терминала и обои'); p.add(g)
        fb = Gtk.FlowBox(max_children_per_line=4, min_children_per_line=2, selection_mode=Gtk.SelectionMode.NONE, column_spacing=10, row_spacing=10)
        cur = open(f'{K}/theme').read().strip() if os.path.exists(f'{K}/theme') else 'night'
        for n, label in THEMES:
            b = Gtk.Button(); box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(f'/usr/share/kora/wallpapers/{n}.jpg', 168, 95, True)
                pic = Gtk.Picture.new_for_pixbuf(pb); pic.set_size_request(168, 95); box.append(pic)
            except Exception: pass
            box.append(Gtk.Label(label=label + ('  ✓' if n == cur else ''))); b.set_child(box); b.add_css_class('flat')
            b.connect('clicked', lambda _b, n=n: (subprocess.Popen(['kora-theme', n]), self.toast('Тема применена')))
            fb.insert(b, -1)
        g.add(fb)
        g2 = group('Окна'); p.add(g2)
        dd = Gtk.DropDown.new_from_strings(['macOS — цветные кружки слева', 'Windows — кнопки справа'])
        dd.set_selected(0 if (open(f'{K}/buttons').read().strip() if os.path.exists(f'{K}/buttons') else 'mac') == 'mac' else 1)
        def setb(d, _):
            open(f'{K}/buttons', 'w').write('mac' if d.get_selected() == 0 else 'win'); subprocess.Popen(['kora-theme'])
        dd.connect('notify::selected', setb); g2.add(row('Кнопки окон', 'Закрыть и развернуть', dd))
        b = Gtk.Button(label='Выбрать…'); b.connect('clicked', self.pick_wall); g2.add(row('Свои обои', 'Любая картинка', b))
        cm = Gtk.DropDown.new_from_strings(['Автоматически', 'Hyprland — анимации и размытие', 'labwc — максимальная лёгкость'])
        mode = open(f'{K}/compositor').read().strip() if os.path.exists(f'{K}/compositor') else 'auto'
        cm.set_selected({'auto': 0, 'hyprland': 1, 'labwc': 2}.get(mode, 0))
        cm.connect('notify::selected', lambda d, _: (open(f'{K}/compositor', 'w').write(['auto', 'hyprland', 'labwc'][d.get_selected()]), self.toast('Применится после повторного входа')))
        g2.add(row('Оконная оболочка', 'Hyprland нужен видеокарте с ускорением', cm))
    def pick_wall(self, *_):
        d = Gtk.FileDialog(title='Обои'); f = Gtk.FileFilter(); f.add_mime_type('image/*'); s = Gio.ListStore.new(Gtk.FileFilter); s.append(f); d.set_filters(s)
        def done(dlg, res):
            try:
                path = dlg.open_finish(res).get_path(); open(f'{K}/custom-wallpaper', 'w').write(path); subprocess.Popen(['kora-theme'])
            except Exception: pass
        d.open(self.win, None, done)

    # ---- Power
    def p_power(self, p):
        g = group('Питание'); p.add(g)
        if shutil.which('powerprofilesctl'):
            prof = ['power-saver', 'balanced', 'performance']; cur = sh('powerprofilesctl get')
            dd = Gtk.DropDown.new_from_strings(['Экономия батареи', 'Баланс', 'Производительность']); dd.set_selected(prof.index(cur) if cur in prof else 1)
            dd.connect('notify::selected', lambda d, _: sh(f'powerprofilesctl set {prof[d.get_selected()]}')); g.add(row('Режим работы', None, dd))
        bat = sh("upower -i $(upower -e | grep -m1 BAT) 2>/dev/null | grep -E 'percentage|state|time to'").replace('\n', ' · ')
        g.add(row('Аккумулятор', re.sub(r'\s+', ' ', bat) or 'Не обнаружен'))
        for lbl, cmd in [('Заблокировать', 'kora-lock'), ('Перезагрузить', 'systemctl reboot'), ('Выключить', 'systemctl poweroff')]:
            b = Gtk.Button(label=lbl); b.connect('clicked', lambda _b, c=cmd: subprocess.Popen(c, shell=True)); g.add(row(lbl, None, b))

    # ---- Apps
    def p_apps(self, p):
        g = group('Приложения', 'Устанавливаются из интернета'); p.add(g)
        for name, desc, check, cmd in [
            ('LibreWolf', 'Приватный браузер', 'librewolf', 'sudo extrepo enable librewolf && sudo apt-get update && sudo apt-get install -y librewolf'),
            ('LibreOffice', 'Документы, таблицы, презентации', 'libreoffice', 'sudo apt-get update && sudo apt-get install -y libreoffice-writer libreoffice-calc libreoffice-impress libreoffice-gtk3 libreoffice-l10n-ru'),
            ('Telegram', 'Мессенджер', None, 'kora-telegram'), ('Zoom', 'Видеозвонки', 'zoom', 'kora-zoom')]:
            have = check and shutil.which(check)
            b = Gtk.Button(label='Установлено' if have else 'Установить', sensitive=not have); b.connect('clicked', lambda _b, c=cmd: term(c))
            g.add(row(name, desc, b))

    # ---- Doctor
    def p_doctor(self, p):
        g = group('Kora Доктор', 'Проверка оборудования и системы'); p.add(g); self.dg = g; self.drows = []
        bar = Gtk.Box(spacing=8)
        b1 = Gtk.Button(label='Проверить снова'); b1.connect('clicked', lambda *_: self.doc_run())
        b2 = Gtk.Button(label='Сохранить отчёт'); b2.connect('clicked', lambda *_: self.toast(f'Отчёт сохранён: {report()}'))
        bar.append(b1); bar.append(b2); g.set_header_suffix(bar); GLib.idle_add(self.doc_run)
    def doc_run(self):
        def work():
            res = checks(); GLib.idle_add(self.doc_show, res)
        threading.Thread(target=work, daemon=True).start(); return False
    def doc_show(self, res):
        for r in self.drows: self.dg.remove(r)
        self.drows = []
        icons = {'ok': 'emblem-ok-symbolic', 'warn': 'dialog-warning-symbolic', 'bad': 'dialog-error-symbolic'}
        for st, title, detail, fl, fc in res:
            r = Adw.ActionRow(title=title, subtitle=detail); r.set_subtitle_lines(4); im = Gtk.Image(icon_name=icons[st]); im.add_css_class({'ok': 'success', 'warn': 'warning', 'bad': 'error'}[st]); r.add_prefix(im)
            if fl and fc:
                b = Gtk.Button(label=fl); b.set_valign(Gtk.Align.CENTER); b.add_css_class('suggested-action')
                b.connect('clicked', lambda _b, c=fc: (subprocess.Popen(c[8:], shell=True) if c.startswith('USERCMD:') else root(c), GLib.timeout_add(4000, self.doc_run)))
                r.add_suffix(b)
            self.dg.add(r); self.drows.append(r)
        return False

    # ---- About
    def p_about(self, p):
        g = group(); p.add(g)
        img = Gtk.Image.new_from_file('/usr/share/kora/logo-256.png'); img.set_pixel_size(96); g.add(img)
        cpu = sh("grep -m1 'model name' /proc/cpuinfo | cut -d: -f2").strip(); mem = sh("free -h | awk '/Mem/{print $2}'")
        gpu = sh("lspci | grep -iE 'vga|3d|display' | cut -d: -f3 | head -1").strip()
        g2 = group('О системе'); p.add(g2)
        for t, v in [('Версия', sh('cat /etc/kora-release') or 'Kora OS'), ('Ядро', sh('uname -r')), ('Процессор', cpu), ('Память', mem), ('Графика', gpu),
                     ('Режим', 'Живая система с флешки' if LIVE else 'Установлена на диск')]:
            g2.add(row(t, v))
        if LIVE:
            b = Gtk.Button(label='Установить Kora OS'); b.add_css_class('suggested-action'); b.connect('clicked', lambda *_: subprocess.Popen(['kora-install'])); g2.add(row('Установка на диск', None, b))

Settings().run(sys.argv)
