#!/bin/sh
# configures automatic Btrfs snapshots (Timeshift) + boot menu entries for them (grub-btrfs). Run as root on an installed system.
[ "$(findmnt -no FSTYPE /)" = btrfs ] || { echo "Корень не на Btrfs — снимки недоступны."; exit 0; }
DEV=$(findmnt -no SOURCE / | sed 's/\[.*//'); UUID=$(blkid -s UUID -o value "$DEV")
mkdir -p /etc/timeshift
cat > /etc/timeshift/timeshift.json <<J
{"backup_device_uuid":"$UUID","btrfs_mode":"true","include_btrfs_home_for_backup":"false","stop_cron_emails":"true",
 "schedule_monthly":"false","schedule_weekly":"true","schedule_daily":"true","schedule_hourly":"false","schedule_boot":"true",
 "count_monthly":"2","count_weekly":"3","count_daily":"5","count_hourly":"6","count_boot":"3","exclude":[]}
J
systemctl enable --now grub-btrfsd 2>/dev/null || true
sed -i 's#^ExecStart=.*grub-btrfsd.*#ExecStart=/usr/bin/grub-btrfsd --syslog --timeshift-auto#' /lib/systemd/system/grub-btrfsd.service 2>/dev/null && systemctl daemon-reload
timeshift --create --comments "Kora: после установки" --scripted >/dev/null 2>&1 || true
update-grub >/dev/null 2>&1 || true
